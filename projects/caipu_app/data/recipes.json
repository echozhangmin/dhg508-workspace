    {
      "name": "番茄炒蛋",
      "cuisine": "家常",
      "difficulty": "简单",
      "minutes": 15,
      "summary": "酸甜下饭的国民家常菜。",
      "ingredients": [
        {"name": "番茄", "amount": "2 个", "essential": true},
        {"name": "鸡蛋", "amount": "3 个", "essential": true},
        {"name": "葱", "amount": "1 根", "essential": false},
        {"name": "糖", "amount": "1 小勺", "essential": false},
        {"name": "盐", "amount": "适量", "essential": false}
      ],
      "steps": [
        "番茄切块，葱切葱花；鸡蛋打散，加少许盐。",
        "热锅倒油，油热后倒入蛋液，炒至刚凝固就盛出。",
        "锅里留底油，下番茄块中火翻炒出汁，加 1 小勺糖和适量盐。",
        "倒回鸡蛋翻炒均匀，撒葱花出锅。"
      ]
    },
