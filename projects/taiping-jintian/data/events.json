  {"event_id": 6, "name_zh": "金田起义", "name_en": "Jintian Uprising", "date_raw": "1851年1月11日（道光三十年十二月初十日，洪秀全生日）", "date_norm": "1851-01-11", "date_system": "lunar-qing", "place_id": 4, "kind": "founding", "summary": "拜上帝会众在金田村「恭祝万寿」起义，建号太平天国，颁军纪五条。", "doc_id": "wiki-jintianqiyi", "locator": "经过", "note": "公历1851，清纪年仍属道光三十年；13日东出大湟江口。"},
  {"event_id": 7, "name_zh": "永安建制", "name_en": "Yong'an organisation", "date_raw": "咸丰元年十二月（通行标为1851年12月）", "date_norm": "", "date_system": "lunar-qing", "place_id": 10, "kind": "institution", "summary": "攻占永安后在当地封五王：东王杨秀清、西王萧朝贵、南王冯云山、北王韦昌辉、翼王石达开，令东王节制诸王。", "doc_id": "wiki-yongan", "locator": "经过", "note": "洪秀全在永安称天王、称万岁；避讳故诸王不称「王爷」。"},
  {"event_id": 8, "name_zh": "永安突围", "name_en": "Breakout from Yong'an", "date_raw": "咸丰二年（1852年）二月", "date_norm": "1852", "date_system": "lunar-qing", "place_id": 10, "kind": "battle", "summary": "太平军趁雨夜弃永安州北犯桂林；清将乌兰泰追至昭平山中遭伏大败，后于将军桥中炮，伤重卒于军中。", "doc_id": "wiki-wulantai", "locator": "戰歿", "note": "旧稿误作「乌兰泰在攻永安一役中阵亡」，核对原文后改为追击时中炮伤卒。"},
